<script>
    // --- 状態管理用のグローバル変数（二重定義エラーを防ぐため、存在しない場合のみ初期化） ---
    if (typeof userIpAddress === 'undefined') window.userIpAddress = "";
    if (typeof isChatFrozen === 'undefined') window.isChatFrozen = false;
    
    // 💡 カッコが絶対に消えないように書き直しました
    if (typeof chatArray === 'undefined') window.chatArray = new Array();
    if (typeof proxyArray === 'undefined') window.proxyArray = new Array();
    if (typeof rankArray === 'undefined') window.rankArray = new Array();
    if (typeof blacklistArray === 'undefined') window.blacklistArray = new Array();
    if (typeof lastSendTime === 'undefined') window.lastSendTime = 0;
    
    // セッションIDの固定
    let mySessionId = localStorage.getItem('chat_session_id') || 'user_' + Math.random().toString(36).substring(2, 9);
    localStorage.setItem('chat_session_id', mySessionId);

    let isAdmin = localStorage.getItem('saved_user_role') === 'admin';
    let isMod = localStorage.getItem('saved_user_role') === 'mod';

    function checkLoginSession() { 
        const s = localStorage.getItem('saved_user_role'); 
        if (s === 'admin') applyAdminUI(); 
        else if (s === 'mod') applyModUI(); 
    }

        function loadAllData() {
        if (typeof google === "undefined" || !google.script || !google.script.run) return;
        
        google.script.run.withSuccessHandler(function(data) {
            if (!data) return;
            chatArray = data.chat ? JSON.parse(data.chat) : new Array(); 
            proxyArray = data.proxy ? JSON.parse(data.proxy) : new Array(); 
            rankArray = data.ranking ? JSON.parse(data.ranking) : new Array();
            
            // 各種UIの描画処理（存在する場合のみ実行）
            if (typeof renderChat === "function") renderChat(); 
            if (typeof renderProxies === "function") renderProxies(); 
            if (typeof renderLeaderboard === "function") renderLeaderboard(); 
            if (typeof renderSoundboard === "function") renderSoundboard();
            
            // 💡【重要修正】ここで予定表のUIを初期状態（社会や数学など）で無理やり上書きしてしまう
            // 「updateGameUI()」や予定表の連動バグを防ぐため、チャット・プロキシ・ランキングのみを正確に描画させます。
            
        }).getGlobalData();
        
        blacklistArray = JSON.parse(localStorage.getItem('gas_blacklist')) || new Array();
        if (isAdmin && typeof renderBlacklist === "function") renderBlacklist();
        
        // 💡 ページを開いたとき、予定表（時間割）のデータも最新版をサーバーから引っ張ってきて画面に固定する
        if (typeof google.script.run.getSavedSchedules === "function") {
            google.script.run
                .withSuccessHandler(function(schedules) {
                    for (let i = 1; i <= 6; i++) {
                        const liElement = document.getElementById(`period_${i}`);
                        if (liElement && schedules[i]) {
                            liElement.innerText = schedules[i];
                        }
                    }
                })
                .getSavedSchedules();
        }
    }

    function renderChat() {
        const box = document.getElementById('chatLog'); 
        if (!box) return; 
        const isBottom = box.scrollHeight - box.clientHeight <= box.scrollTop + 10; 
        box.innerHTML = "";
        
        chatArray.forEach((msg, i) => {
            const cls = (msg.senderId === mySessionId) ? ' chat-msg my-msg' : ' chat-msg';
            let name = (msg.role === 'admin') ? `<span class="admin-name">${escapeHTML(msg.name)}</span>` : (msg.role === 'mod') ? `<span class="mod-name">${escapeHTML(msg.name)}</span>` : `<strong>${escapeHTML(msg.name)}</strong>`;
            let btn = isAdmin ? `<button class="admin-btn" onclick="editChatMessage(${i})">📝</button><button class="admin-btn" onclick="deleteChatMessage(${i})">×</button>` : isMod ? `<button class="admin-btn" onclick="deleteChatMessage(${i})">×</button>` : '';
            
            let bodyText = escapeHTML(msg.text);
            if (msg.text && msg.text.indexOf('[IMAGE_DATA]:') === 0) {
                bodyText = `<br><img src="${msg.text.substring(13)}" style="max-width:150px; max-height:150px; border-radius:4px; margin-top:5px;">`;
            } else if (msg.text && msg.text.indexOf('/') === 0 && msg.text.indexOf('.mp3') !== -1) {
                bodyText = `<span style="color:#28a745; font-weight:bold;">🎵 効果音ボタンを設置しました！</span>`;
            }
            box.innerHTML += `<div class="${cls}">${name}: ${bodyText} <span class="chat-time">${msg.time}</span> ${btn}</div>`;
        });
        if (isBottom) box.scrollTop = box.scrollHeight;
    }

    function renderSoundboard() {
        const sBox = document.getElementById('soundboardBox'); 
        if (!sBox) return;
        sBox.innerHTML = ""; 
        let hasSound = false;
        
        chatArray.forEach(msg => {
            if (msg.text && msg.text.indexOf('/') === 0 && msg.text.indexOf('.mp3') !== -1) {
                const cleanText = msg.text.substring(1), spaceIdx = cleanText.indexOf(' ');
                if (spaceIdx !== -1) {
                    const btnName = cleanText.substring(0, spaceIdx), mp3Url = cleanText.substring(spaceIdx + 1).trim();
                    hasSound = true;
                    const btn = document.createElement('button'); btn.className = 'sound-pad'; btn.textContent = btnName;
                    btn.onclick = function() { new Audio(mp3Url).play(); };
                    sBox.appendChild(btn);
                }
            }
        });
        if (!hasSound) sBox.innerHTML = "<p style='font-size:0.85rem; color:#888;'>チャット欄に「/ボタン名 mp3URL」を入力するとここに設置されます。</p>";
    }

    function sendChatMessage() {
        // ❄️ チャット凍結チェック（管理人は凍結されていても送信可能）
        if (isChatFrozen && !isAdmin) {
            alert("❄️ 現在チャットは管理者によって凍結されているため、送信できません。");
            return;
        }

        const nameIn = document.getElementById('chatName'), textIn = document.getElementById('chatInput');
        if (!nameIn || !textIn) return;
        
        const name = nameIn.value.trim() || "名無し", msgText = textIn.value.trim();
        if (blacklistArray.includes(name)) { alert("❌ アクセス禁止されています。"); return; }
        if (msgText === "") return;
        if (msgText.length > 200 && msgText.indexOf('[IMAGE_DATA]:') !== 0) { alert("❌ 200文字制限です。"); return; }
        
        if (!isAdmin && !isMod) {
            const nowTime = new Date().getTime();
            if (nowTime - lastSendTime < 2000) { alert("❌ 2秒間は連投できません！"); return; }
            lastSendTime = nowTime;
        }
        
        const now = new Date(), time = String(now.getHours()).padStart(2,'0') + ":" + String(now.getMinutes()).padStart(2,'0');
        chatArray.push({ name: name + (isAdmin ? " (管理人)" : isMod ? " (モデレーター)" : ""), text: msgText, time: time, senderId: mySessionId, role: isAdmin ? 'admin' : isMod ? 'mod' : 'user' });
        
        google.script.run.withSuccessHandler(loadAllData).saveGlobalData('g_chat', JSON.stringify(chatArray)); 
        textIn.value = "";
    }

    function toggleStampBox() { const box = document.getElementById('stampBox'); box.style.display = (box.style.display==='none'||box.style.display==='')?'flex':'none'; }
    function sendStamp(emoji) { document.getElementById('chatInput').value = "[スタンプ] " + emoji; sendChatMessage(); toggleStampBox(); }
    
    function handleImageSelect(input) {
        if (input.files && input.files[0]) {
            const file = input.files[0];
            if (file.size > 800 * 1024) { alert("❌ 画像は800KB以下にしてください。"); input.value = ""; return; }
            const reader = new FileReader();
            reader.onload = function(e) { document.getElementById('chatInput').value = "[IMAGE_DATA]:" + e.target.result; sendChatMessage(); input.value = ""; };
            reader.readAsDataURL(file);
        }
    }

    function promptAdminLogin() { if (prompt("パスワード：") === "109") { localStorage.setItem('saved_user_role', 'admin'); applyAdminUI(); } else alert("❌ 違います。"); }
    function promptModLogin() { if (prompt("パスワード：") === "108") { localStorage.setItem('saved_user_role', 'mod'); applyModUI(); } else alert("❌ 違います。"); }
    
    function applyAdminUI() {
        isAdmin = true; isMod = false; 
        if(document.getElementById('adminLoginBtn')) document.getElementById('adminLoginBtn').style.display = 'none'; 
        if(document.getElementById('modLoginBtn')) document.getElementById('modLoginBtn').style.display = 'none';
        if(document.getElementById('badgeAdmin')) document.getElementById('badgeAdmin').style.display = 'inline'; 
        if(document.getElementById('badgeMod')) document.getElementById('badgeMod').style.display = 'none'; 
        if(document.getElementById('logoutBtn')) document.getElementById('logoutBtn').style.display = 'inline';
        if(document.getElementById('navAdminPanel')) document.getElementById('navAdminPanel').style.display = 'inline-block'; 
        loadAllData();
        checkServerStatus();
    }
    
    function applyModUI() {
        isAdmin = false; isMod = true; 
        if(document.getElementById('adminLoginBtn')) document.getElementById('adminLoginBtn').style.display = 'none'; 
        if(document.getElementById('modLoginBtn')) document.getElementById('modLoginBtn').style.display = 'none';
        if(document.getElementById('badgeAdmin')) document.getElementById('badgeAdmin').style.display = 'none'; 
        if(document.getElementById('badgeMod')) document.getElementById('badgeMod').style.display = 'inline'; 
        if(document.getElementById('logoutBtn')) document.getElementById('logoutBtn').style.display = 'inline';
        if(document.getElementById('navAdminPanel')) document.getElementById('navAdminPanel').style.display = 'none'; 
        loadAllData();
    }
    
    function logout() {
        localStorage.removeItem('saved_user_role'); isAdmin = false; isMod = false;
        if(document.getElementById('adminLoginBtn')) document.getElementById('adminLoginBtn').style.display = 'inline'; 
        if(document.getElementById('modLoginBtn')) document.getElementById('modLoginBtn').style.display = 'inline';
        if(document.getElementById('badgeAdmin')) document.getElementById('badgeAdmin').style.display = 'none'; 
        if(document.getElementById('badgeMod')) document.getElementById('badgeMod').style.display = 'none'; 
        if(document.getElementById('logoutBtn')) document.getElementById('logoutBtn').style.display = 'none';
        if(document.getElementById('navAdminPanel')) document.getElementById('navAdminPanel').style.display = 'none'; 
        if(typeof switchTab === "function") switchTab('scheduleSection', document.querySelector('.tab-btn')); 
        loadAllData();
    }
    
    function applyScoreCheat() {
    if (!isAdmin) return;
    const input = document.getElementById('cheatScoreInput'); 
    const amount = parseInt(input.value, 10);
    if (!isNaN(amount) && amount > 0) { 
        score += amount; 
        updateGameUI(); 
        alert(`💎 チート成功：+ ${amount}`); 
        input.value = ""; 
    }
}

function addBlacklist() {
    const input = document.getElementById('blacklistInput');
    if (input && input.value.trim() && !blacklistArray.includes(input.value.trim())) { 
        blacklistArray.push(input.value.trim());
        localStorage.setItem('gas_blacklist', JSON.stringify(blacklistArray));
        renderBlacklist();
        input.value = "";
    }
}

function removeBlacklist(i) { 
    blacklistArray.splice(i, 1); 
    localStorage.setItem('gas_blacklist', JSON.stringify(blacklistArray)); 
    renderBlacklist(); 
}

function renderBlacklist() {
    const box = document.getElementById('blacklistLog'); 
    if (!box) return; 
    box.innerHTML = "";
    blacklistArray.forEach((name, idx) => { 
        box.innerHTML += `<div class="blacklist-item"><span>${escapeHTML(name)}</span><button onclick="removeBlacklist(${idx})">解除</button></div>`; 
    });
}

function editChatMessage(i) { 
    if (isAdmin) { 
        const t = prompt("編集：", chatArray[i].text); 
        if (t) { 
            chatArray[i].text = t.trim(); 
            google.script.run.withSuccessHandler(loadAllData).saveGlobalData('g_chat', JSON.stringify(chatArray)); 
        } 
    } 
}

function deleteChatMessage(i) { 
    if (isAdmin || isMod) { 
        if (confirm("削除しますか？")) { 
            chatArray.splice(i, 1); 
            google.script.run.withSuccessHandler(loadAllData).saveGlobalData('g_chat', JSON.stringify(chatArray)); 
        } 
    } 
}

function escapeHTML(str) {
    if (!str) return "";
    return str.replace(/[&<>'"]/g, tag => ({
        '&': '&amp;', '<': '&lt;', '>': '&gt;', "'": '&#39;', '"': '&quot;'
    }[tag] || tag));
}

// ==========================================
// 🛡️ 凍結・IPBAN用の管理・サーバー同期ロジック
// ==========================================

function checkServerStatus() {
    if (typeof google === "undefined" || !google.script || !google.script.run) return;
    google.script.run
        .withSuccessHandler((status) => {
            if (!status) return;
            if (status.isBanned) {
                alert("⚠️ あなたのIPアドレスはアクセスが禁止されています。");
                document.body.innerHTML = "<h1 style='text-align:center; margin-top:100px; color:red; font-family:sans-serif;'>🚨 Access Denied (IP BAN)</h1>";
                return;
            }
            updateFreezeDisplay(status.isFrozen);
            const ipLogBox = document.getElementById('ipBanLog');
            if (ipLogBox && status.ipList) {
                ipLogBox.innerHTML = status.ipList.map(ip => `<div>🚫 ${ip}</div>`).join('');
            }
        })
        .checkUserStatus(userIpAddress);
}

window.addEventListener('load', async () => {
    checkLoginSession();
    loadAllData();

    // ネットワーク負荷を下げるため30秒周期で見回り
    setInterval(checkServerStatus, 30000);

    try {
        const res = await fetch('https://ipify.org');
        const data = await res.json();
        userIpAddress = data.ip;
        checkServerStatus();
    } catch (e) {
        console.warn("IPの取得に失敗しましたが、チャットは利用可能です:", e);
        checkServerStatus();
    }
});

function toggleChatFreeze() {
    if (!isAdmin) { alert("最高管理者権限が必要です。"); return; }
    google.script.run
        .withSuccessHandler((frozen) => { updateFreezeDisplay(frozen); })
        .setChatFreeze(!isChatFrozen);
}

function updateFreezeDisplay(frozen) {
    isChatFrozen = frozen;
    const btn = document.getElementById('freezeBtn');
    const status = document.getElementById('freezeStatus');
    if (btn && status) {
        if (frozen) {
            btn.innerText = "🔓 チャットの凍結を解除"; 
            btn.style.background = "#dc3545"; 
            btn.style.color = "#fff";
            status.innerText = "❄️ チャット凍結中（一般ユーザー送信不可）";
        } else {
            btn.innerText = "🔒 チャットを凍結する"; 
            btn.style.background = "#ffc107"; 
            btn.style.color = "#222";
            status.innerText = "✅ 通常稼働中";
        }
    }
}

function addIpBan() {
    const ipInput = document.getElementById('ipBanInput'); 
    if (!ipInput) return;
    const ip = ipInput.value.trim(); 
    if (!ip) return;
    
    google.script.run
        .withSuccessHandler((ipList) => {
            ipInput.value = "";
            const ipLogBox = document.getElementById('ipBanLog');
            if (ipLogBox) { 
                ipLogBox.innerHTML = ipList.map(item => `<div>🚫 ${item}</div>`).join(''); 
            }
            alert(`IPアドレス [ ${ip} ] をBANリストに登録しました。`);
        })
        .registerIpBan(ip);
}
</script>
